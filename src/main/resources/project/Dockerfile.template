# To build a Dockerized version execute: `docker build -t web3app .`
FROM ubuntu as Build
COPY . /root/app
RUN apt-get update && apt-get install -y \
	ca-certificates curl bash jq openjdk-21-jre \
	&& rm -rf /var/cache/apk/* \
	&& curl --disable --proto '=https' --proto-redir '=https' --fail --show-error --silent --location https://get.web3j.io -o /tmp/web3j-installer.sh \
	&& sh /tmp/web3j-installer.sh \
	&& rm -f /tmp/web3j-installer.sh \
	&& /root/.web3j/web3j \
	&& cd /root/app \
	&& ./gradlew generateContractWrappers

FROM alpine
COPY --from=Build /root /root/
RUN apk add --no-cache bash openjdk21-jre\
	&& rm -rf /var/cache/apk/* \
	&& mkdir /opt/app
WORKDIR /root/app
ENTRYPOINT /root/.web3j/web3j run ${WEB3J_NODE_URL} ${WEB3J_WALLET_PATH} ${WEB3J_WALLET_PASSWORD}
